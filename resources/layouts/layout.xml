    <label
        id="btn_back"
        text=""
        x="90%"
        y="65%"
        font="Gfx.FONT_TINY"
        color="Gfx.COLOR_LT_GRAY"
        justification="Gfx.TEXT_JUSTIFY_RIGHT"
    />
    <label
        id="btn_next"
        text=""
        x="10%"
